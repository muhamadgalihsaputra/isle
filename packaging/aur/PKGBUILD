# Maintainer: zickrian <espejodaniel50@gmail.com>
# Isle from its release tarball, with the programs GitHub Actions built. After a release,
# `./update.sh <version>` sets the version and checksum here and in .SRCINFO.

pkgname=isle-bin
pkgver=1.3.1
pkgrel=1
pkgdesc='A notch-style island for the GNOME Shell top bar: music with synced lyrics, calls, a focus timer, a calendar, a file shelf and a voice assistant'
arch=('x86_64')
url='https://github.com/zickrian/isle'
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('gnome-shell>=1:46' 'dconf' 'gtk4' 'glib2' 'pango' 'gdk-pixbuf2' 'gcc-libs' 'glibc' 'bash')
optdepends=('vulkan-icd-loader: speech recognition on the graphics card, else on the processor'
  'python: optional Isle MCP server'
  'python-virtualenv: set up the optional Isle MCP server')
provides=('isle')
conflicts=('isle')
options=('!strip' '!debug')
install=isle-bin.install
source_x86_64=("https://github.com/zickrian/isle/releases/download/v$pkgver/isle-$pkgver-$CARCH-linux.tar.gz")
sha256sums_x86_64=('3f94c2537f2fba44e4df5dce600d5d4e319d687674d7b92a65426441fad19025')

package() {
  cd "isle-$pkgver-$CARCH-linux"
  local uuid=isle@zickrian.github.io

  install -Dm755 -t "$pkgdir/usr/bin" bin/isled bin/isle-shelf bin/isle-whisper scripts/isle-charge-limit
  install -Dm755 scripts/setup-voice.sh "$pkgdir/usr/bin/isle-setup-voice"
  install -Dm755 scripts/setup-mcp.sh "$pkgdir/usr/bin/isle-setup-mcp"
  install -Dm755 scripts/isle-mcp "$pkgdir/usr/bin/isle-mcp"
  install -Dm644 mcp/server.py "$pkgdir/usr/lib/isle/mcp/server.py"
  install -Dm644 mcp/requirements.txt "$pkgdir/usr/share/isle/mcp/requirements.txt"

  local ext="$pkgdir/usr/share/gnome-shell/extensions/$uuid"
  install -d "$ext"
  cp -r --no-preserve=ownership gnome-extension/. "$ext/"
  # The settings schema goes where the system compiles it; the extension then finds it there.
  install -Dm644 -t "$pkgdir/usr/share/glib-2.0/schemas" "$ext"/schemas/*.gschema.xml
  rm -r "$ext/schemas"
  chmod -R u=rwX,go=rX "$ext"

  local service
  for service in io.github.zickrian.isle.Daemon.service io.github.zickrian.isle.ShelfWindow.service isled.service isle-mcp.service; do
    sed -e 's|@BINDIR@|/usr/bin|' -e 's|file://%h/.local/share/doc/isle|file:///usr/share/doc/isle|' \
      "data/$service" > "$srcdir/$service"
  done
  install -Dm644 -t "$pkgdir/usr/share/dbus-1/services" \
    "$srcdir/io.github.zickrian.isle.Daemon.service" "$srcdir/io.github.zickrian.isle.ShelfWindow.service"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$srcdir/isled.service"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$srcdir/isle-mcp.service"

  install -Dm644 -t "$pkgdir/usr/share/fonts/isle" data/fonts/InterVariable.ttf
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE data/fonts/Inter-LICENSE.txt
  install -Dm644 -t "$pkgdir/usr/share/doc/isle" README.md CHANGELOG.md
  install -Dm644 docs/mcp.md "$pkgdir/usr/share/doc/isle/mcp.md"
}
